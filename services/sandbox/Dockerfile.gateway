# Both stages use official images. Only the CLI binary is copied into the gateway.
ARG DOCKER_CLI_IMAGE=docker:28-cli
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${PYTHON_IMAGE}
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp \
    DOCKER_HOST=unix:///run/learner-engine/docker.sock \
    SANDBOX_PRIVATE_NETWORK=1 SANDBOX_BIND=0.0.0.0 SANDBOX_PORT=8090
WORKDIR /opt/gateway
COPY gateway.py validation.py model_broker.py smoke_test.py ./
RUN groupadd --gid 10002 gateway \
    && useradd --uid 10002 --gid 10002 --no-create-home --home-dir /tmp gateway \
    && mkdir -p /run/learner-engine \
    && docker --version
USER 10002:10002
ENTRYPOINT ["python", "-s", "/opt/gateway/gateway.py"]
