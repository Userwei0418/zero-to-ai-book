# Replace the hostname. Caddy obtains/renews a public TLS certificate after DNS
# points to this server and ports 80/443 are reachable. Never expose port 8090.
sandbox.example.com {
    request_body {
        max_size 2097152
    }
    reverse_proxy 127.0.0.1:8090 {
        transport http {
            response_header_timeout 90s
        }
    }
    header {
        Cache-Control no-store
        X-Content-Type-Options nosniff
    }
}
