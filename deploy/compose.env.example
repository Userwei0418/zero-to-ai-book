# docker compose --env-file /etc/zero-ai-book/compose.env ...
# Hostname only; DNS must point to the application host.
BOOK_DOMAIN=book.example.org
BOOK_CONFIG_DIR=/etc/zero-ai-book
BOOK_RELEASE=local
GUIDE_MODEL_BASE_URL=https://token.sensetime.com/api/v1
GUIDE_MODEL_NAME=sensenova-6.8-flash
GUIDE_DAILY_LIMIT=100
# Anonymous visitors: guide attempts per visitor and across all visitors per UTC day,
# then total Linux execution requests across all visitors per UTC day.
GUEST_AI_DAILY_LIMIT=3
GUEST_AI_SITE_DAILY_LIMIT=30
GUEST_RUNTIME_SITE_DAILY_LIMIT=60

# Optional sandbox profile: set these only after building/verifying the guest.
# BOOK_SANDBOX_URL=http://sandbox-gateway:8090
# LEARNER_DOCKER_SOCKET=/run/user/1005/docker.sock
# LEARNER_SOCKET_GID=1005
# BOOK_GUEST_IMAGE=zero-to-ai-guest:local
# BOOK_SANDBOX_ID=zero-ai-compose
# LAB_SESSIONS=2
# LAB_ACCOUNT_SESSIONS=1
# LAB_PARALLEL=1
# LAB_IDLE_SECONDS=180
# LAB_TIMEOUT_SECONDS=15
