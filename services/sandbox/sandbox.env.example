# Copy outside the repository and protect it with mode 0600.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SANDBOX_TOKEN=CHANGE_ME
SANDBOX_BIND=127.0.0.1
SANDBOX_PORT=8090
SANDBOX_IMAGE=ai-book-sandbox:1
SANDBOX_DEPLOYMENT_ID=ai-book-lab
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_IDLE_SECONDS=900
SANDBOX_MAX_SESSIONS=12
SANDBOX_MAX_EXECUTIONS=4
SANDBOX_MAX_HTTP_REQUESTS=24
# Optional, takes precedence over SANDBOX_TOKEN:
# SANDBOX_TOKEN_FILE=/etc/ai-book-sandbox/token

# Optional real model provider. These values remain ONLY on the gateway host.
# Empty key = explicit model-unavailable errors; never fabricated model answers.
TOKENPLAN_API_KEY=
TOKENPLAN_BASE_URL=https://token.sensetime.com/api/v1
TOKENPLAN_MODEL=sensenova-6.8-flash
SANDBOX_MODEL_TIMEOUT_SECONDS=25
SANDBOX_MODEL_CALLS_PER_EXECUTION=12
# For multi-call model lessons the operator may explicitly raise the entire
# execution budget to 60 seconds. Provider calls remain inside that deadline.
